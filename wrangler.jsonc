{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spell-calculator",
  "main": "worker/index.ts",
  "compatibility_date": "2025-02-04",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS"
  },
  // Create with: npm run kv:create — then paste the id below.
  "kv_namespaces": [
    {
      "binding": "WORKSPACE_KV",
      "id": "8432d5e4449044b4b98b404367201867",
      "preview_id": "2c42b0fda0ba49a8ad91bb468c2bca6e"
    }
  ]
}
